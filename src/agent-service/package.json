{
  "name": "@codeagent/agent-service",
  "version": "0.1.0",
  "description": "Agent service with JSON-RPC and Electron IPC adapters",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "agent-service": "bin/rpc-server.ts"
  },
  "scripts": {
    "start": "bun run bin/rpc-server.ts",
    "dev": "bun run bin/rpc-server.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:smoke": "vitest run tests/smoke",
    "test:regression": "vitest run tests/regression --reporter=verbose",
    "test:performance": "vitest run tests/performance --reporter=verbose",
    "test:contract": "vitest run tests/contract",
    "test:chaos": "vitest run tests/chaos",
    "test:snapshot": "vitest run tests/snapshot"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.61.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}