{
  "name": "codeagent",
  "version": "0.1.0",
  "description": "CodeAgent - AI-powered terminal assistant with multi-provider LLM support",
  "main": "dist/apps/cli/index.js",
  "bin": {
    "codeagent": "dist/apps/cli/index.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/apps/cli/index.tsx",
    "build": "bun build src/apps/cli/index.tsx --target=node --outfile=dist/apps/cli/index.js",
    "start": "bun run dist/apps/cli/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "prepare": "husky",
    "audit": "bun pm scan",
    "audit:size": "bundlesize"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyu528/CodeAgent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zhangyu528/CodeAgent/issues"
  },
  "homepage": "https://github.com/zhangyu528/CodeAgent#readme",
  "dependencies": {
    "@byteland/ink-scroll-bar": "^1.0.0",
    "@mariozechner/pi-agent-core": "^0.61.1",
    "@mariozechner/pi-ai": "^0.61.1",
    "dotenv": "^17.3.1",
    "ink": "~6.8.0",
    "ink-scroll-view": "^0.3.6",
    "react": "^19.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.4.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "bundlesize": "^0.18.2",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  }
}
