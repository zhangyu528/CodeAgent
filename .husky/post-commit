#!/usr/bin/env sh
# Husky post-commit hook
# 当 git commit 完成后自动发送 commit 报告到飞书

PROJECT_DIR="/mnt/d/work/project/CodeAgent"
cd "$PROJECT_DIR"

# 获取当前 commit 信息
COMMIT_MSG=$(git log -1 --pretty=%B | head -20)
COMMIT_HASH=$(git log -1 --pretty=%h)
COMMIT_TIME=$(git log -1 --pretty=%ci | cut -d' ' -f1,2 | sed 's/+08:00//')
BRANCH=$(git branch --show-current)

# 获取变更统计
FILES_CHANGED=$(git diff --name-only HEAD^..HEAD | wc -l)
INSERTIONS=$(git diff --numstat HEAD^..HEAD | awk '{add += $1} END {print add}')
DELETIONS=$(git diff --numstat HEAD^..HEAD | awk '{del += $2} END {print del}')

# 获取变更文件列表
FILES=$(git diff --name-only HEAD^..HEAD | head -30)
TOTAL_FILES=$(git diff --name-only HEAD^..HEAD | wc -l)
if [ "$TOTAL_FILES" -gt 30 ]; then
    FILES="$FILES
... 还有 $(( TOTAL_FILES - 30 )) 个文件"
fi

# 分类统计
NEW_FILES=$(git diff --name-only --diff-filter=A HEAD^..HEAD | wc -l)
MODIFIED_FILES=$(git diff --name-only --diff-filter=M HEAD^..HEAD | wc -l)
DELETED_FILES=$(git diff --name-only --diff-filter=D HEAD^..HEAD | wc -l)

SRC_CHANGES=$(git diff --name-only HEAD^..HEAD | grep -E "^src/" | wc -l)
TEST_CHANGES=$(git diff --name-only HEAD^..HEAD | grep -E "^tests/" | wc -l)
SCRIPT_CHANGES=$(git diff --name-only HEAD^..HEAD | grep -E "^scripts/" | wc -l)

# 发送到飞书
FEISHU_WEBHOOK_URL=$(grep "FEISHU_WEBHOOK_URL" "$PROJECT_DIR/scripts/.env" | cut -d'=' -f2)

if [ -n "$FEISHU_WEBHOOK_URL" ]; then
    RESULT=$(python3 -c "
import sys
sys.path.insert(0, '$PROJECT_DIR/scripts')
from feishu_webhook import send_card, card_commit_report

card = card_commit_report(
    commit_hash='$COMMIT_HASH',
    branch='$BRANCH',
    commit_time='$COMMIT_TIME',
    commit_msg='''$COMMIT_MSG'''.strip(),
    files_changed=$FILES_CHANGED,
    insertions=$INSERTIONS,
    deletions=$DELETIONS,
    new_files=$NEW_FILES,
    modified_files=$MODIFIED_FILES,
    deleted_files=$DELETED_FILES,
    src_changes=$SRC_CHANGES,
    test_changes=$TEST_CHANGES,
    script_changes=$SCRIPT_CHANGES,
    files='''$FILES'''.strip()
)

from feishu_webhook import send_card
result = send_card('$FEISHU_WEBHOOK_URL', card)
print('SUCCESS' if result.get('code') == 0 else 'FEISHU_ERROR:' + str(result))
" 2>&1)

    if [ "$RESULT" = "SUCCESS" ]; then
        echo "✅ Commit 报告已发送到飞书"
    else
        echo "❌ 飞书发送失败: $RESULT"
    fi
else
    echo "❌ 未配置 FEISHU_WEBHOOK_URL"
fi
