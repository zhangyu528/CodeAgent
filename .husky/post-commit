#!/usr/bin/env sh
# Husky post-commit hook
# 当 git commit 完成后自动发送变更报告到飞书

PROJECT_DIR="/mnt/d/work/project/CodeAgent"
cd "$PROJECT_DIR"

# 获取当前 commit 信息（commit 后立即执行，所以用 HEAD）
COMMIT_MSG=$(git log -1 --pretty=%B | head -20)
COMMIT_HASH=$(git log -1 --pretty=%h)
COMMIT_TIME=$(git log -1 --pretty=%ci | cut -d' ' -f1,2 | sed 's/+08:00//')
BRANCH=$(git branch --show-current)

# 获取变更统计（相对于 HEAD^，即上一个 commit）
FILES_CHANGED=$(git diff --name-only HEAD^..HEAD | wc -l)
INSERTIONS=$(git diff --numstat HEAD^..HEAD | awk '{add += $1} END {print add}')
DELETIONS=$(git diff --numstat HEAD^..HEAD | awk '{del += $2} END {print del}')

# 获取变更文件列表
FILES=$(git diff --name-only HEAD^..HEAD | head -30)
TOTAL_FILES=$(git diff --name-only HEAD^..HEAD | wc -l)
if [ "$TOTAL_FILES" -gt 30 ]; then
    FILES="$FILES
... 还有 $(( TOTAL_FILES - 30 )) 个文件"
fi

# 分类统计
NEW_FILES=$(git diff --name-only --diff-filter=A HEAD^..HEAD | wc -l)
MODIFIED_FILES=$(git diff --name-only --diff-filter=M HEAD^..HEAD | wc -l)
DELETED_FILES=$(git diff --name-only --diff-filter=D HEAD^..HEAD | wc -l)

SRC_CHANGES=$(git diff --name-only HEAD^..HEAD | grep -E "^src/" | wc -l)
TEST_CHANGES=$(git diff --name-only HEAD^..HEAD | grep -E "^tests/" | wc -l)
SCRIPT_CHANGES=$(git diff --name-only HEAD^..HEAD | grep -E "^scripts/" | wc -l)

# 生成报告内容
REPORT_TEXT="📝 Git Commit 报告

🔖 commit: ${COMMIT_HASH}
📋 分支: ${BRANCH}
⏰ 时间: ${COMMIT_TIME}

━━━━━━━━━━━━━━━━━━━━━━━

📊 变更统计:
• 文件数: ${FILES_CHANGED} 个
• 新增: ${NEW_FILES} 个
• 修改: ${MODIFIED_FILES} 个
• 删除: ${DELETED_FILES} 个
• +${INSERTIONS} / -${DELETIONS} 行

📁 变更分类:
• 源代码: ${SRC_CHANGES} 个
• 测试文件: ${TEST_CHANGES} 个
• 脚本: ${SCRIPT_CHANGES} 个

📝 Commit 消息:
${COMMIT_MSG}

━━━━━━━━━━━━━━━━━━━━━━━
变更文件:
${FILES}
"

echo "$REPORT_TEXT"

# 发送到飞书（用 Python 处理 JSON 转义，检查 curl 返回值）
FEISHU_WEBHOOK_URL=$(grep "FEISHU_WEBHOOK_URL" "$PROJECT_DIR/scripts/.env" | cut -d'=' -f2)

if [ -n "$FEISHU_WEBHOOK_URL" ]; then
    RESULT=$(python3 -c "
import json, urllib.request, sys

text = '''${REPORT_TEXT}'''
webhook = '''${FEISHU_WEBHOOK_URL}'''

payload = json.dumps({'msg_type': 'text', 'content': {'text': text}})

try:
    req = urllib.request.Request(
        webhook,
        data=payload.encode('utf-8'),
        headers={'Content-Type': 'application/json'}
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        result = json.loads(resp.read().decode())
        if result.get('code') == 0:
            print('SUCCESS')
        else:
            print('FEISHU_ERROR:' + str(result))
            sys.exit(1)
except Exception as e:
    print('CURL_ERROR:' + str(e))
    sys.exit(1)
" 2>&1)

    if [ "$RESULT" = "SUCCESS" ]; then
        echo ""
        echo "✅ 已发送到飞书"
    else
        echo ""
        echo "❌ 飞书发送失败: $RESULT"
    fi
else
    echo "❌ 未配置 FEISHU_WEBHOOK_URL"
fi

# 记录日志
echo "[$(date)] Commit ${COMMIT_HASH}: $RESULT" >> "$PROJECT_DIR/scripts/git_hooks/hook.log"
